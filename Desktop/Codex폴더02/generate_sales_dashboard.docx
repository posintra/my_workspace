from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path

from openpyxl import load_workbook
from reportlab.lib import colors
from reportlab.lib.enums import TA_LEFT
from reportlab.lib.pagesizes import A4, landscape
from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
from reportlab.lib.units import mm
from reportlab.pdfbase import pdfmetrics
from reportlab.pdfbase.ttfonts import TTFont
from reportlab.platypus import (
    KeepTogether,
    PageBreak,
    Paragraph,
    SimpleDocTemplate,
    Spacer,
    Table,
    TableStyle,
    Flowable,
)


ROOT = Path(r"C:\Users\SKTelecom\Desktop\Codex폴더")
WORKBOOK = ROOT / "모듈실행파일_002_summary생성.xlsm"
OUTPUT_PDF = ROOT / "sales-dashboard_260514.pdf"

FONT_REGULAR = "MalgunGothic"
FONT_BOLD = "MalgunGothic-Bold"
FONT_PATH = Path(r"C:\Windows\Fonts\malgun.ttf")
FONT_BOLD_PATH = Path(r"C:\Windows\Fonts\malgunbd.ttf")


def register_fonts() -> None:
    if FONT_REGULAR not in pdfmetrics.getRegisteredFontNames():
        pdfmetrics.registerFont(TTFont(FONT_REGULAR, str(FONT_PATH)))
    if FONT_BOLD not in pdfmetrics.getRegisteredFontNames():
        pdfmetrics.registerFont(TTFont(FONT_BOLD, str(FONT_BOLD_PATH)))


def fmt_money(value) -> str:
    if value is None:
        return "-"
    try:
        return f"{int(round(float(value))):,}"
    except Exception:
        return str(value)


def fmt_date(value) -> str:
    if value is None:
        return "-"
    try:
        return value.strftime("%Y-%m-%d")
    except Exception:
        return str(value)


def as_float(value) -> float:
    if value is None:
        return 0.0
    try:
        return float(value)
    except Exception:
        try:
            return float(str(value).replace(",", ""))
        except Exception:
            return 0.0


@dataclass(frozen=True)
class Metric:
    label: str
    value: float
    color: str


class MetricBar(Flowable):
    def __init__(self, metric: Metric, maximum: float, width: float = 490.0, height: float = 16.0):
        super().__init__()
        self.metric = metric
        self.maximum = max(maximum, 1.0)
        self.width = width
        self.height = height

    def wrap(self, availWidth, availHeight):
        return self.width, self.height

    def draw(self):
        c = self.canv
        w = self.width
        h = self.height

        label_w = 70
        value_w = 92
        track_w = max(10, w - label_w - value_w - 10)
        track_x = label_w
        bar_pct = min(1.0, max(0.0, self.metric.value / self.maximum))
        fill_w = track_w * bar_pct

        c.setFont(FONT_BOLD, 8.8)
        c.setFillColor(colors.HexColor("#33485c"))
        c.drawString(0, 3.2, self.metric.label)

        c.setStrokeColor(colors.HexColor("#d9e2ec"))
        c.setFillColor(colors.HexColor("#edf2f7"))
        c.roundRect(track_x, 1.8, track_w, 11.0, 5.5, stroke=1, fill=1)

        if fill_w > 0:
            c.setStrokeColor(colors.HexColor(self.metric.color))
            c.setFillColor(colors.HexColor(self.metric.color))
            c.roundRect(track_x, 1.8, fill_w, 11.0, 5.5, stroke=0, fill=1)

        c.setFont(FONT_BOLD, 8.8)
        c.setFillColor(colors.HexColor("#172533"))
        c.drawRightString(w, 3.2, fmt_money(self.metric.value))


def money_style(size: int = 9, bold: bool = False, color: str = "#172533") -> ParagraphStyle:
    return ParagraphStyle(
        name=f"money_{size}_{int(bold)}_{color}",
        fontName=FONT_BOLD if bold else FONT_REGULAR,
        fontSize=size,
        leading=size + 2,
        textColor=colors.HexColor(color),
        alignment=TA_LEFT,
    )


def title_style(size: int = 18, color: str = "#172533") -> ParagraphStyle:
    return ParagraphStyle(
        name=f"title_{size}_{color}",
        fontName=FONT_BOLD,
        fontSize=size,
        leading=size + 4,
        textColor=colors.HexColor(color),
        alignment=TA_LEFT,
    )


def section_table(title: str, subtitle: str, rows: list[list], col_widths: list[float]) -> Table:
    header = Table([[Paragraph(title, title_style(15)), Paragraph(subtitle, money_style(9, False, "#66788a"))]], colWidths=[sum(col_widths) - 170, 170])
    header.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, -1), colors.white),
                ("LEFTPADDING", (0, 0), (-1, -1), 0),
                ("RIGHTPADDING", (0, 0), (-1, -1), 0),
                ("TOPPADDING", (0, 0), (-1, -1), 0),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 0),
            ]
        )
    )

    body = Table(rows, colWidths=col_widths, hAlign="LEFT")
    body.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, -1), colors.white),
                ("BOX", (0, 0), (-1, -1), 0.8, colors.HexColor("#d9e2ec")),
                ("INNERGRID", (0, 0), (-1, -1), 0.4, colors.HexColor("#edf2f7")),
                ("LEFTPADDING", (0, 0), (-1, -1), 10),
                ("RIGHTPADDING", (0, 0), (-1, -1), 10),
                ("TOPPADDING", (0, 0), (-1, -1), 8),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
                ("VALIGN", (0, 0), (-1, -1), "TOP"),
            ]
        )
    )

    outer = Table([[header], [body]], colWidths=[sum(col_widths)])
    outer.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, -1), colors.white),
                ("BOX", (0, 0), (-1, -1), 0.8, colors.HexColor("#d9e2ec")),
                ("TOPPADDING", (0, 0), (-1, -1), 10),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 10),
                ("LEFTPADDING", (0, 0), (-1, -1), 0),
                ("RIGHTPADDING", (0, 0), (-1, -1), 0),
            ]
        )
    )
    return outer


def person_row(person: dict, metrics: list[Metric], name_width: float, bar_width: float) -> list:
    max_v = max((m.value for m in metrics), default=1.0)
    bar_stack = [
        Paragraph("목표금액 대비 기저금액 대비 추정금액 가로막대", money_style(8, False, "#7a8b9d")),
        Spacer(1, 2.5),
    ]
    for metric in metrics:
        bar_stack.append(MetricBar(metric, max_v, width=bar_width))
        bar_stack.append(Spacer(1, 2))

    return [
        Paragraph(person["name"], money_style(10, True)),
        bar_stack,
    ]


def build_people_section(title: str, subtitle: str, people: list[dict], value_keys: tuple[str, str, str]) -> KeepTogether:
    annual_colors = ("#165dff", "#f59e0b", "#10a37f")
    metrics_people = []
    all_values = []
    for person in people:
        metrics = [
            Metric("목표", as_float(person[value_keys[0]]), annual_colors[0]),
            Metric("기저", as_float(person[value_keys[1]]), annual_colors[1]),
            Metric("추정", as_float(person[value_keys[2]]), annual_colors[2]),
        ]
        all_values.extend(m.value for m in metrics)
        metrics_people.append((person, metrics))

    metrics_people.sort(key=lambda item: item[1][2].value, reverse=True)
    max_v = max(all_values) if all_values else 1.0

    rows = [[Paragraph("영업담당자", money_style(9, True, "#324255")), Paragraph("목표 / 기저 / 추정", money_style(9, True, "#324255"))]]
    for person, metrics in metrics_people:
        bar_stack = [MetricBar(metric, max_v, width=500.0) for metric in metrics]
        rows.append(
            [
                Paragraph(person["name"], money_style(10, True)),
                [Paragraph(" ", money_style(1)), *bar_stack],
            ]
        )

    table = Table(rows, colWidths=[90 * mm, 170 * mm], repeatRows=1, hAlign="LEFT")
    table.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#eef3f7")),
                ("TEXTCOLOR", (0, 0), (-1, 0), colors.HexColor("#324255")),
                ("FONTNAME", (0, 0), (-1, 0), FONT_BOLD),
                ("FONTSIZE", (0, 0), (-1, 0), 9),
                ("BOX", (0, 0), (-1, -1), 0.8, colors.HexColor("#d9e2ec")),
                ("INNERGRID", (0, 0), (-1, -1), 0.35, colors.HexColor("#edf2f7")),
                ("LEFTPADDING", (0, 0), (-1, -1), 9),
                ("RIGHTPADDING", (0, 0), (-1, -1), 9),
                ("TOPPADDING", (0, 0), (-1, -1), 8),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
                ("VALIGN", (0, 0), (-1, -1), "TOP"),
            ]
        )
    )

    return KeepTogether(
        [
            Paragraph(title, title_style(15)),
            Spacer(1, 2),
            Paragraph(subtitle, money_style(9, False, "#66788a")),
            Spacer(1, 8),
            table,
        ]
    )


def main() -> None:
    register_fonts()
    wb = load_workbook(WORKBOOK, data_only=True, keep_vba=True)
    ws = wb["목표실적요약"]

    execution_date = fmt_date(ws["B2"].value)
    current_quarter = str(ws["D2"].value or "-")

    team_rows = [
        ["팀 구분", "목표금액", "기저금액", "추정금액"],
        ["팀 연간", fmt_money(ws["B5"].value), fmt_money(ws["C5"].value), fmt_money(ws["D5"].value)],
        ["팀 분기 누적", fmt_money(ws["B6"].value), fmt_money(ws["C6"].value), fmt_money(ws["D6"].value)],
        ["팀 현 분기", fmt_money(ws["B7"].value), fmt_money(ws["C7"].value), fmt_money(ws["D7"].value)],
    ]

    people = []
    for row in range(11, 20):
        people.append(
            {
                "name": ws[f"A{row}"].value,
                "annual_goal": as_float(ws[f"B{row}"].value),
                "annual_base": as_float(ws[f"C{row}"].value),
                "annual_forecast": as_float(ws[f"D{row}"].value),
                "quarter_goal": as_float(ws[f"E{row}"].value),
                "quarter_base": as_float(ws[f"F{row}"].value),
                "quarter_forecast": as_float(ws[f"G{row}"].value),
            }
        )

    annual_sorted = sorted(people, key=lambda p: p["annual_forecast"], reverse=True)
    quarter_sorted = sorted(people, key=lambda p: p["quarter_forecast"], reverse=True)

    styles = getSampleStyleSheet()
    styles.add(title_style(22))

    doc = SimpleDocTemplate(
        str(OUTPUT_PDF),
        pagesize=landscape(A4),
        leftMargin=11 * mm,
        rightMargin=11 * mm,
        topMargin=10 * mm,
        bottomMargin=10 * mm,
    )

    elements = []

    header = Table(
        [
            [
                Paragraph("영업실적 대시보드", title_style(22, "#ffffff")),
                Paragraph(
                    f"실행일 <b>{execution_date}</b><br/>기준분기 <b>{current_quarter}</b>",
                    money_style(10, False, "#d8e4f0"),
                ),
            ]
        ],
        colWidths=[220 * mm, 60 * mm],
    )
    header.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#172533")),
                ("BOX", (0, 0), (-1, -1), 0, colors.HexColor("#172533")),
                ("LEFTPADDING", (0, 0), (-1, -1), 16),
                ("RIGHTPADDING", (0, 0), (-1, -1), 16),
                ("TOPPADDING", (0, 0), (-1, -1), 14),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 14),
                ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
            ]
        )
    )
    elements.append(header)
    elements.append(Spacer(1, 8))

    kpi = Table(
        [
            [
                Paragraph("실행일<br/><b>%s</b>" % execution_date, money_style(10)),
                Paragraph("기준분기<br/><b>%s</b>" % current_quarter, money_style(10)),
                Paragraph("팀 연간 목표금액<br/><b>%s</b>" % fmt_money(ws["B5"].value), money_style(10)),
                Paragraph("팀 연간 추정금액<br/><b>%s</b><br/>기저 %s" % (fmt_money(ws["D5"].value), fmt_money(ws["C5"].value)), money_style(10)),
            ]
        ],
        colWidths=[67 * mm, 67 * mm, 67 * mm, 67 * mm],
    )
    kpi.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, -1), colors.white),
                ("BOX", (0, 0), (-1, -1), 0.8, colors.HexColor("#d9e2ec")),
                ("INNERGRID", (0, 0), (-1, -1), 0.4, colors.HexColor("#edf2f7")),
                ("LEFTPADDING", (0, 0), (-1, -1), 10),
                ("RIGHTPADDING", (0, 0), (-1, -1), 10),
                ("TOPPADDING", (0, 0), (-1, -1), 9),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 9),
                ("VALIGN", (0, 0), (-1, -1), "TOP"),
            ]
        )
    )
    elements.append(kpi)
    elements.append(Spacer(1, 10))

    summary_table = Table(team_rows, colWidths=[46 * mm, 55 * mm, 55 * mm, 55 * mm], hAlign="LEFT")
    summary_table.setStyle(
        TableStyle(
            [
                ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#eef3f7")),
                ("FONTNAME", (0, 0), (-1, 0), FONT_BOLD),
                ("FONTSIZE", (0, 0), (-1, -1), 9),
                ("TEXTCOLOR", (0, 0), (-1, 0), colors.HexColor("#324255")),
                ("BOX", (0, 0), (-1, -1), 0.8, colors.HexColor("#d9e2ec")),
                ("INNERGRID", (0, 0), (-1, -1), 0.35, colors.HexColor("#edf2f7")),
                ("LEFTPADDING", (0, 0), (-1, -1), 8),
                ("RIGHTPADDING", (0, 0), (-1, -1), 8),
                ("TOPPADDING", (0, 0), (-1, -1), 8),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
                ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
            ]
        )
    )
    elements.append(Paragraph("팀 요약", title_style(15)))
    elements.append(Spacer(1, 3))
    elements.append(summary_table)
    elements.append(Spacer(1, 10))

    annual_section = build_people_section(
        "영업담당자별 연간 목표/기저/추정 가로막대",
        "각 영업담당자별로 목표금액, 기저금액, 추정금액을 같은 스케일의 가로 막대로 표시",
        annual_sorted,
        ("annual_goal", "annual_base", "annual_forecast"),
    )
    elements.append(annual_section)
    elements.append(PageBreak())

    quarter_section = build_people_section(
        "영업담당자별 분기누적 목표/기저/추정 가로막대",
        "분기누적 기준으로 동일한 방식의 가로 막대를 다시 표시",
        quarter_sorted,
        ("quarter_goal", "quarter_base", "quarter_forecast"),
    )
    elements.append(quarter_section)
    elements.append(Spacer(1, 10))
    elements.append(
        Paragraph(
            "원본 워크북의 `목표실적요약` 시트 값을 그대로 사용했습니다. 개인 분기 비율 항목은 이번 PDF에서 제외했습니다.",
            money_style(8, False, "#7a8b9d"),
        )
    )

    def page_canvas(canvas, doc):
        canvas.saveState()
        canvas.setFont(FONT_REGULAR, 8)
        canvas.setFillColor(colors.HexColor("#7a8b9d"))
        canvas.drawRightString(doc.pagesize[0] - doc.rightMargin, 8 * mm, f"sales-dashboard_260514.pdf  |  {execution_date}")
        canvas.restoreState()

    doc.build(elements, onFirstPage=page_canvas, onLaterPages=page_canvas)


if __name__ == "__main__":
    main()
